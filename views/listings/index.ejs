<% layout("/layouts/boilerplate") %>


<!-- ========================================================= -->
<!-- MAIN LISTINGS CONTAINER -->
<!-- ========================================================= -->

<div class="listings-container">


    <!-- ===================================================== -->
    <!-- CATEGORY BAR -->
    <!-- ===================================================== -->

    <div class="category-bar">


        <!-- ================= TRENDING ================= -->

        <a
            href="/listings"
            class="category-item <%= !category ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-fire"></i>

            <span>
                Trending
            </span>

        </a>


        <!-- ================= ROOMS ================= -->

        <a
            href="/listings?category=Rooms"
            class="category-item <%= category === 'Rooms' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-bed"></i>

            <span>
                Rooms
            </span>

        </a>


        <!-- ================= ICONIC CITIES ================= -->

        <a
            href="/listings?category=Iconic%20Cities"
            class="category-item <%= category === 'Iconic Cities' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-city"></i>

            <span>
                Iconic Cities
            </span>

        </a>


        <!-- ================= MOUNTAINS ================= -->

        <a
            href="/listings?category=Mountains"
            class="category-item <%= category === 'Mountains' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-mountain"></i>

            <span>
                Mountains
            </span>

        </a>


        <!-- ================= CASTLES ================= -->

        <a
            href="/listings?category=Castles"
            class="category-item <%= category === 'Castles' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-chess-rook"></i>

            <span>
                Castles
            </span>

        </a>


        <!-- ================= AMAZING POOLS ================= -->

        <a
            href="/listings?category=Amazing%20Pools"
            class="category-item <%= category === 'Amazing Pools' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-person-swimming"></i>

            <span>
                Amazing Pools
            </span>

        </a>


        <!-- ================= CAMPING ================= -->

        <a
            href="/listings?category=Camping"
            class="category-item <%= category === 'Camping' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-campground"></i>

            <span>
                Camping
            </span>

        </a>


        <!-- ================= FARMS ================= -->

        <a
            href="/listings?category=Farms"
            class="category-item <%= category === 'Farms' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-wheat-awn"></i>

            <span>
                Farms
            </span>

        </a>


        <!-- ================= ARCTIC ================= -->

        <a
            href="/listings?category=Arctic"
            class="category-item <%= category === 'Arctic' ? 'active' : '' %>"
            style="text-decoration: none; color: inherit; cursor: pointer;"
        >

            <i class="fa-solid fa-snowflake"></i>

            <span>
                Arctic
            </span>

        </a>


    </div>



    <!-- ===================================================== -->
    <!-- SEARCH BAR -->
    <!-- ===================================================== -->

    <div class="search-container">

        <div class="search-box">


            <!-- Search icon -->

            <i class="fa-solid fa-magnifying-glass"></i>


            <!-- Search input -->

            <input
                type="text"
                id="listingSearch"
                placeholder="Search destinations, locations..."
                autocomplete="off"
            >


            <!-- Search button -->

            <button
                type="button"
                id="searchButton"
            >
                Search
            </button>


        </div>

    </div>



    <!-- ===================================================== -->
    <!-- TAX SWITCH -->
    <!-- ===================================================== -->

    <div class="tax-switch-container">

        <div class="tax-switch-content">


            <span class="tax-switch-text">
                Display total price with taxes
            </span>


            <label class="tax-switch">


                <input
                    type="checkbox"
                    id="taxSwitch"
                >


                <span class="tax-slider"></span>


            </label>


        </div>

    </div>



    <!-- ===================================================== -->
    <!-- PAGE TITLE -->
    <!-- ===================================================== -->

    <h1 class="listings-heading">


        <% if (category) { %>

            <%= category %>

        <% } else { %>

            All Listings

        <% } %>


    </h1>



    <!-- ===================================================== -->
    <!-- LISTINGS GRID -->
    <!-- ===================================================== -->

    <div
        class="row row-cols-lg-3 row-cols-md-2 row-cols-1"
        id="listingsGrid"
    >


        <!-- ================================================= -->
        <!-- NO LISTINGS -->
        <!-- ================================================= -->

        <% if (allListings.length === 0) { %>


            <div class="col-12">


                <div
                    class="text-center py-5"
                    style="width: 100%;"
                >


                    <i
                        class="fa-solid fa-house-circle-xmark"
                        style="font-size: 50px;"
                    >
                    </i>


                    <h3 class="mt-3">
                        No listings available
                    </h3>


                    <p class="text-muted">
                        There are currently no listings in this category.
                    </p>


                </div>


            </div>


        <% } %>



        <!-- ================================================= -->
        <!-- DISPLAY LISTINGS -->
        <!-- ================================================= -->

        <% for (let listing of allListings) { %>


            <div
                class="col mb-4 listing-item"
                data-title="<%= listing.title.toLowerCase() %>"
                data-location="<%= listing.location.toLowerCase() %>"
                data-country="<%= listing.country.toLowerCase() %>"
            >


                <!-- Listing link -->

                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link"
                >


                    <div class="card listing-card">


                        <!-- ================= IMAGE ================= -->

                        <% if (
                            listing.image &&
                            listing.image.url
                        ) { %>


                            <img
                                src="<%= listing.image.url %>"
                                class="card-img-top"
                                alt="<%= listing.title %>"
                            >


                        <% } else { %>


                            <div class="no-image-placeholder">

                                No image available

                            </div>


                        <% } %>



                        <!-- ================= DETAILS ================= -->

                        <div class="card-body">


                            <!-- Title -->

                            <p class="listing-title">

                                <strong>
                                    <%= listing.title %>
                                </strong>

                            </p>


                            <!-- Location -->

                            <p class="listing-location">

                                <%= listing.location %>,
                                <%= listing.country %>

                            </p>


                            <!-- Price -->

                            <p class="card-text listing-price">


                                ₹


                                <span
                                    class="price-value"
                                    data-price="<%= listing.price %>"
                                >

                                    <%= listing.price.toLocaleString("en-IN") %>

                                </span>


                                / night


                            </p>


                        </div>


                    </div>


                </a>


            </div>


        <% } %>


    </div>



    <!-- ===================================================== -->
    <!-- NO SEARCH RESULTS -->
    <!-- ===================================================== -->

    <div
        id="noSearchResults"
        class="no-search-results"
        style="display: none;"
    >


        <i class="fa-solid fa-magnifying-glass"></i>


        <h4>
            No listings found
        </h4>


        <p>
            Try searching for another destination or location.
        </p>


    </div>


</div>



<!-- ========================================================= -->
<!-- SEARCH JAVASCRIPT -->
<!-- ========================================================= -->

<script>


    // Search input

    const searchInput =
        document.getElementById(
            "listingSearch"
        );


    // Search button

    const searchButton =
        document.getElementById(
            "searchButton"
        );


    // All listings

    const listingItems =
        document.querySelectorAll(
            ".listing-item"
        );


    // No search results

    const noSearchResults =
        document.getElementById(
            "noSearchResults"
        );



    // =========================================================
    // SEARCH FUNCTION
    // =========================================================

    function searchListings() {


        const searchText =
            searchInput.value
                .toLowerCase()
                .trim();


        let matchingListings = 0;



        listingItems.forEach(
            function (listing) {


                const title =
                    listing.dataset.title || "";


                const location =
                    listing.dataset.location || "";


                const country =
                    listing.dataset.country || "";



                const matches =
                    title.includes(searchText) ||
                    location.includes(searchText) ||
                    country.includes(searchText);



                if (matches) {


                    listing.style.display =
                        "";


                    matchingListings++;


                } else {


                    listing.style.display =
                        "none";


                }


            }
        );



        if (
            matchingListings === 0 &&
            searchText !== ""
        ) {


            noSearchResults.style.display =
                "block";


        } else {


            noSearchResults.style.display =
                "none";


        }


    }



    // Search button click

    searchButton.addEventListener(
        "click",
        searchListings
    );



    // Search while typing

    searchInput.addEventListener(
        "input",
        searchListings
    );



    // Search using Enter

    searchInput.addEventListener(
        "keydown",
        function (event) {


            if (event.key === "Enter") {

                searchListings();

            }


        }
    );


</script>



<!-- ========================================================= -->
<!-- TAX JAVASCRIPT -->
<!-- ========================================================= -->

<script>


    // Tax switch

    const taxSwitch =
        document.getElementById(
            "taxSwitch"
        );


    // Price elements

    const priceElements =
        document.querySelectorAll(
            ".price-value"
        );


    // Tax rate

    const taxRate = 0.18;



    // Check tax switch

    if (taxSwitch) {


        taxSwitch.addEventListener(
            "change",
            function () {


                priceElements.forEach(
                    function (priceElement) {


                        const originalPrice =
                            Number(
                                priceElement.dataset.price
                            );


                        const priceWithTax =
                            originalPrice +
                            (
                                originalPrice *
                                taxRate
                            );



                        // Tax ON

                        if (taxSwitch.checked) {


                            priceElement.innerText =
                                Math.round(
                                    priceWithTax
                                ).toLocaleString(
                                    "en-IN"
                                );


                        }


                        // Tax OFF

                        else {


                            priceElement.innerText =
                                originalPrice.toLocaleString(
                                    "en-IN"
                                );


                        }


                    }
                );


            }
        );


    }


</script>
