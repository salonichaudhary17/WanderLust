<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">
        Login
    </h1>

    <div class="col-6 offset-3">

        <form
            method="POST"
            action="/login"
            class="needs-validation"
            novalidate
        >

            <div class="mb-3">
                <label
                    for="username"
                    class="form-label"
                >
                    Username
                </label>

                <input
                    type="text"
                    name="username"
                    id="username"
                    class="form-control"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter your username.
                </div>
            </div>

            <div class="mb-3">
                <label
                    for="password"
                    class="form-label"
                >
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    id="password"
                    class="form-control"
                    required
                >

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter your password.
                </div>
            </div>

            <button class="btn btn-success">
                Login
            </button>

        </form>

    </div>
</div>

<script>
(() => {
    "use strict";

    const forms =
        document.querySelectorAll(".needs-validation");

    Array.from(forms).forEach(form => {

        form.addEventListener(
            "submit",
            event => {

                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add(
                    "was-validated"
                );

            },
            false
        );
    });
})();
</script>